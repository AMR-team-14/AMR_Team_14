name: Merge experiment logs
on:
  workflow_dispatch:
    inputs:
      pr:
        description: Result pull request number
        required: true
        type: number
permissions:
  contents: write
  pull-requests: write
jobs:
  merge:
    if: github.ref == 'refs/heads/main'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/github-script@v7
        with:
          script: |
            const repo = context.repo;
            const number = Number(context.payload.inputs.pr);
            const {data: pr} = await github.rest.pulls.get({...repo, pull_number: number});
            if (pr.base.ref !== 'main' || pr.head.repo?.id !== pr.base.repo.id || pr.state !== 'open' || pr.draft) throw Error('Invalid PR');
            const files = await github.paginate(github.rest.pulls.listFiles, {...repo, pull_number: number});
            if (!files.length || files.length !== pr.changed_files) throw Error('Incomplete file list');
            for (const file of files) {
              if (file.status !== 'added' || !/^team-experiments\/case[1-5]\/[\w.-]+\.json$/.test(file.filename)) throw Error('Unexpected change');
              const {data} = await github.rest.repos.getContent({...repo, path: file.filename, ref: pr.head.sha});
              if (data.type !== 'file' || data.sha !== file.sha || data.encoding !== 'base64') throw Error('Invalid blob');
              const rows = JSON.parse(Buffer.from(data.content,'base64').toString('utf8'));
              if (!Array.isArray(rows) || !rows.length) throw Error('Empty batch');
              for (const r of rows) {
                for (const k of ['candidate','input','engine','aggregation','source']) {
                  if (typeof r[k] !== 'string' || !r[k].trim()) throw Error('Missing '+k);
                }
                if (!Array.isArray(r.seeds) || !r.seeds.length || !r.seeds.every(Number.isSafeInteger)) throw Error('Invalid seeds');
                if (r.score !== null && !Number.isFinite(r.score)) throw Error('Invalid score');
              }
            }
            const result = await github.rest.pulls.merge({...repo, pull_number:number, sha:pr.head.sha});
            if (!result.data.merged) throw Error(result.data.message);
