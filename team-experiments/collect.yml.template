name: Collect team experiment records
on:
  workflow_dispatch:
permissions:
  contents: write
concurrency:
  group: collect-team-experiments
  cancel-in-progress: false
jobs:
  collect:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          ref: jsm
          fetch-depth: 0
      - name: Collect published records
        run: |
          git fetch --no-tags --prune origin '+refs/heads/*:refs/remotes/origin/*'
          node team-experiments/collect.mjs
          git add -f -- team-experiments/case{1,2,3,4,5}/inventory.csv team-experiments/shared/inventory.csv
          find team-experiments -type d -name archive -prune -exec git add -f -- {} +
          if ! git diff --cached --quiet; then
            git config user.name github-actions
            git config user.email github-actions@users.noreply.github.com
            git commit -m "Collect team experiment records"
            git push origin HEAD:jsm
          fi
